{
  "$description": "Line height and letter spacing per type tier. Figma's text styles use AUTO / 0%, so these are maintained here. Values are taken from the VCP Design System's type ramp (tokens/semantic/type.json, Oct 2026), which set them explicitly and ships them in production.",
  "display-xl": { "lineHeight": 1.1, "letterSpacing": "-0.02em" },
  "display-lg": { "lineHeight": 1.12, "letterSpacing": "-0.02em" },
  "display-md": { "lineHeight": 1.15, "letterSpacing": "-0.015em" },
  "heading-xl": { "lineHeight": 1.2, "letterSpacing": "-0.015em" },
  "heading-lg": { "lineHeight": 1.25, "letterSpacing": "-0.01em" },
  "heading-md": { "lineHeight": 1.3 },
  "title-md": { "lineHeight": "28px", "letterSpacing": "0.1px" },
  "title-sm": { "lineHeight": "24px", "letterSpacing": "0.1px" },
  "body-lg": { "lineHeight": "26px", "letterSpacing": "0.15px" },
  "body-md": { "lineHeight": "24px", "letterSpacing": "0.25px" },
  "body-sm": { "lineHeight": "20px", "letterSpacing": "0.4px" },
  "label-md": { "lineHeight": "20px", "letterSpacing": "0.1px" },
  "label-sm": { "lineHeight": "18px", "letterSpacing": "0.2px" },
  "caption-md": { "lineHeight": "16px", "letterSpacing": "0.3px" },
  "caption-sm": { "lineHeight": "14px", "letterSpacing": "0.4px" }
}
